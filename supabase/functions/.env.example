# Variables de las Edge Functions (solo nombres, sin valores).
#
# En producción van como secretos de Supabase (`supabase secrets set ...` o
# Project Settings → Edge Functions), nunca en el repo ni con prefijo VITE_.
# Para probar en local: copiar a `supabase/functions/.env` (ignorado por git) y
# `supabase functions serve --env-file supabase/functions/.env`.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase.
# Detalle del correo en EMAIL.md; lista completa en DESPLIEGUE.md (sección 1).

# --- Correo (Brevo, _shared/email.ts) ---
# API key v3 de Brevo (SMTP & API → API keys), no la clave SMTP.
BREVO_API_KEY=
# Remitente; por defecto no-reply@yourcvpassport.com. El dominio debe estar
# autenticado en Brevo.
SENDER_EMAIL=

# --- Boletín (newsletter-contact) ---
BREVO_NEWSLETTER_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_TEMPLATE_ID_EN=
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=

# --- Formulario de prensa ---
PRESS_INBOX_EMAIL=

# --- IA ---
GEMINI_API_KEY=

# --- Rate limit (sin ellos no se limita) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Verificaciones ---
VERIFICATION_CODE_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Otros (opcionales) ---
CORS_EXTRA_ORIGINS=
APP_URL=
