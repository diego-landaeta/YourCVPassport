  "sufijos": [
    {
      "termina": "cion",
      "sustituye": "ción",
      "nota": "Todo sustantivo singular en -ción lleva tilde. El plural -ciones no la lleva y no se toca."
    },
    {
      "termina": "sion",
      "sustituye": "sión",
      "nota": "Idem para -sión."
    }
  ],
  "contextuales": {
    "como": {
      "defecto": "cómo",
      "nota": "Interrogativo indirecto en títulos y listas (Como hacer un CV, como escribir una carta). Se queda sin tilde cuando significa 'en calidad de/igual que'.",
      "reglas": [
        {
          "siguiente": [
            "idioma",
            "requisito",
            "desarrollo",
            "protagonista",
            "norma",
            "sello",
            "carta",
            "recien",
            "freelancer",
            "nomada",
            "introvertido",
            "un"
          ],
          "usar": null
        }
      ]
    },
    "cual": {
      "defecto": "cuál",
      "nota": "En el corpus siempre es interrogativo (CV PDF vs DOCX: cuál enviar).",
      "reglas": []
    },
    "cuando": {
      "defecto": "cuándo",
      "nota": "Interrogativo en titulares/listas (cuándo enviar, cuándo buscar). 'Cuando hablamos de' (subordinada temporal de la plantilla) no se toca.",
      "reglas": [
        {
          "siguiente": [
            "hablamos"
          ],
          "usar": null
        }
      ]
    },
    "que": {
      "defecto": null,
      "nota": "Solo se acentúa tras 'por' (por qué) y al inicio de segmento (título, ítem de lista numerada, inicio de frase), donde es interrogativo. El relativo/conjunción (empleos que desaparecen) se deja.",
      "reglas": [
        {
          "anterior": [
            "por"
          ],
          "usar": "qué"
        },
        {
          "inicio_segmento": true,
          "usar": "qué"
        }
      ]
    },
    "si": {
      "defecto": null,
      "nota": "'el sí' (sustantivo) y 'Sí o No' (afirmación) llevan tilde; el condicional 'si' no.",
      "reglas": [
        {
          "anterior": [
            "el"
          ],
          "usar": "sí"
        },
        {
          "siguiente": [
            "o"
          ],
          "usar": "sí"
        }
      ]
    },
    "esta": {
      "defecto": null,
      "nota": "Demostrativo (esta guía, esta área) sin tilde; verbo estar con tilde.",
      "reglas": [
        {
          "siguiente": [
            "vacio",
            "transformando"
          ],
          "usar": "está"
        }
      ]
    }
  },
  "conservar": {
    "solo": "RAE 2010: adverbio 'solo' sin tilde.",
    "continua": "adjetivo femenino (mejora continua, formación continua), sin tilde.",
    "periodo": "RAE admite 'periodo' y 'período'.",
    "guion": "RAE 2010: monosílabo sin tilde.",
    "brasileiro": "portuguesismo dentro de 'currículo brasileiro'; no es un problema de diacríticos.",
    "bilingualismo": "errata de letras (bilingüismo); fuera del alcance (solo diacríticos)."
  }
